{
    "name": "dynamic/silverstripe-elemental-carousel",
    "description": "A block to implement dynamic/silverstripe-carousel, a simple carousel for Silverstripe in Bootstrap.",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "require": {
        "php": "^8.3",
        "dnadesign/silverstripe-elemental": "^6",
        "dynamic/silverstripe-carousel": "^3"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "silverstripe/recipe-testing": "^4",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Dynamic\\Elements\\Carousel\\": "src/",
            "Dynamic\\Elements\\Carousel\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
